# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# Large RapidOCR ONNX weights (download with scripts/download_models.sh)
assets/models/*.onnx

# ONNX Runtime binaries (scripts/download_onnxruntime.sh).
# src/third_party/onnxruntime_c_api.h stays tracked.
/third_party/onnxruntime*
/third_party/.onnxruntime-download/

# macOS CocoaPods-embedded ORT (copied by podspec prepare_command)
/macos/Libraries/*.dylib
/ios/Libraries/*.dylib

/macos/xue_hua_navite_rapid_ocr/Sources/xue_hua_navite_rapid_ocr/Vendor/*.dylib
